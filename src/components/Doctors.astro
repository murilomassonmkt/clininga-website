---
import { PROFESSIONALS } from '../data/professionals';
import Icon from './Icon.astro';
---

<section class="section doctors" id="medicos">
  <div class="container">
    <div class="section-heading centered reveal">
      <div><p class="eyebrow"><span></span> Corpo clínico</p><h2>Profissionais que cuidam de você</h2></div>
      <p>Conheça os médicos responsáveis pelo atendimento especializado na Cliningá.</p>
    </div>
    <div class="doctors-grid">
      {PROFESSIONALS.map((doctor) => (
        <a class="doctor-card-link" href={doctor.href} aria-label={`Conhecer o currículo de ${doctor.name}`}>
          <article class={`doctor-card doctor-card-${doctor.theme} reveal`}>
            <div class="doctor-photo">
              <img
                src={doctor.image}
                alt={`Foto profissional de ${doctor.name}`}
                width={doctor.imageWidth}
                height={doctor.imageHeight}
                loading="lazy"
                style={`object-position: ${doctor.imagePosition}`}
              />
            </div>
            <div class="doctor-info">
              <p>Corpo clínico</p>
              <h3>{doctor.name}</h3>
              <span>{doctor.specialties}</span>
              <span class="doctor-profile-action">Conheça o currículo <Icon name="arrow" size={17} /></span>
            </div>
          </article>
        </a>
      ))}
    </div>
  </div>
</section>
