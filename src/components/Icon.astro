---
interface Props {
  name: string;
  size?: number;
  label?: string;
}

const { name, size = 24, label } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
>
  {label && <title>{label}</title>}
  {name === 'pin' && <><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></>}
  {name === 'phone' && <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.34 1.78.65 2.62a2 2 0 0 1-.45 2.11L8.04 9.72a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.84.31 1.72.53 2.62.65A2 2 0 0 1 22 16.92Z"/>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {name === 'whatsapp' && <><path d="M20.5 11.6a8.4 8.4 0 0 1-12.4 7.3L3 20.5l1.7-4.9a8.4 8.4 0 1 1 15.8-4Z"/><path d="M8.2 7.8c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.8 1.8c.1.3 0 .5-.2.7l-.6.7c-.2.2-.1.4 0 .6.7 1.2 1.6 2.1 2.8 2.7.2.1.4.2.6 0l.8-1c.2-.2.4-.3.7-.2l1.9.9c.3.1.5.3.5.5 0 .3-.2 1.4-.9 2-.6.6-1.5.8-2.4.6-1.1-.2-2.6-.8-4.2-2.2-1.3-1.2-2.2-2.6-2.7-3.8-.5-1.2-.1-2.6.4-3.3Z"/></>}
  {name === 'arrow' && <><path d="M5 12h14"/><path d="m14 7 5 5-5 5"/></>}
  {name === 'female' && <><circle cx="12" cy="8" r="5"/><path d="M12 13v8M8.5 18h7"/></>}
  {name === 'gastro' && <path d="M10 3c0 3.2-.2 5.1-2.1 6.4-1.5 1-2.5 2.6-2.3 4.7.3 3.3 3.3 6 6.8 5.9 3.7-.1 6.2-2.8 6.1-6.3-.1-3.2-2-4.3-4.2-5.2C12 7.5 12 5.4 12 3"/>}
  {name === 'surgery' && <><path d="m5 4 15 15M14 5l5 5M5 14l5 5"/><path d="m3 21 5-5M16 8l3-3 2 2-3 3"/></>}
  {name === 'video' && <><rect x="3" y="6" width="13" height="12" rx="2"/><path d="m16 10 5-3v10l-5-3"/><circle cx="9.5" cy="12" r="2"/></>}
  {name === 'exam' && <><path d="M4 4h7v5H4zM11 6.5h3a6 6 0 0 1 6 6v0a6 6 0 0 1-6 6h-2"/><path d="M8 9v11M5 20h6"/></>}
  {name === 'clipboard' && <><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M9 10h6M9 14h6"/></>}
  {name === 'mind' && <><path d="M9.5 20H7a3 3 0 0 1-3-3v-2.2A7.5 7.5 0 1 1 16.5 18v2"/><path d="M9 9.5c.8-1.8 3.6-1.8 4.5 0 .8-1.1 2.8-.5 2.8 1.1 0 2.3-3.8 4.4-3.8 4.4s-3.8-2.1-3.8-4.4c0-1.6 2-2.2 2.8-1.1"/></>}
  {name === 'nutrition' && <><path d="M12 21V10"/><path d="M12 14c-4.5 0-7-2.5-7-7 4.5 0 7 2.5 7 7Z"/><path d="M12 11c0-4.5 2.5-7 7-7 0 4.5-2.5 7-7 7Z"/></>}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></>}
</svg>
